# Single public entrypoint for the whole stack: web-app UI, core API, and the
# monitor websocket, all under one domain so there is only one TLS cert to manage.
#
# To enable HTTPS: mount your certificate/key into the container (e.g. at
# /etc/nginx/certs/fullchain.pem and /etc/nginx/certs/privkey.pem) and uncomment
# the "listen 443 ssl" block below, plus the HTTP->HTTPS redirect.

server {
    listen 80;
    server_name ${APP_DOMAIN};

    client_max_body_size 512M;

    # listen 443 ssl;
    # ssl_certificate     /etc/nginx/certs/fullchain.pem;
    # ssl_certificate_key /etc/nginx/certs/privkey.pem;
    # if ($scheme = http) { return 301 https://$host$request_uri; }

    location /api/ {
        proxy_pass http://api:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://monitor:4567;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # The **new** frontend serves the root as of plan 004. The legacy one is still built and
    # still running, and the same plan gave it a published host port (`WEB_APP_PORT`) so that it
    # stays a reference -- it had never needed one, because this proxy was how anybody reached it,
    # so the cutover would otherwise have made it unreachable rather than merely not the front
    # door.
    #
    # The cutover needed more than this line: every legacy URL had to be given somewhere to go
    # first, since `/app/...` paths are in bookmarks, in old emails and on teachers' slides.
    # `repos/web-next/next.config.ts`'s `redirects()` is where that lives, because the mapping is a
    # property of the app's own routes rather than of this deployment -- see the table in
    # `repos/web-next/docs/ROUTES.md`, which the plan turned into code.
    location / {
        proxy_pass http://web-next:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
