---
worker-id: ${WORKER_ID}
worker-description: "docker_worker_${WORKER_ID}"
broker-uri: "${BROKER_URI}"
headers:
    env:
        - bash
        - c-gcc-linux
        - cxx-gcc-linux
        - python3
        - cs-dotnet-core
        - java
    threads: 1
hwgroup: "${WORKER_HWGROUP}"
working-directory: "/var/recodex-worker-wd"
file-managers:
    - hostname: "${API_ADDRESS}"
      username: "${WORKER_FILES_AUTH_USER}"
      password: "${WORKER_FILES_AUTH_PASSWORD}"
file-cache:
    cache-dir: "/var/recodex-worker-cache"
logger:
    file: "/var/log/recodex/worker"
    level: "${LOG_LEVEL}"
    max-size: 1048576
    rotations: 3
limits:
    time: 30
    wall-time: 30
    extra-time: 2
    stack-size: 0
    memory: 1048576
    extra-memory: 64
    parallel: 0
    disk-quotas: false
    disk-size: 1048576
    disk-files: 100
    environ-variable:
        HOME: /box
        PATH: /usr/bin:/bin
        # .NET writes a first-run marker, a telemetry sentinel and a NuGet fallback folder under
        # $HOME the first time the CLI runs. Inside isolate, $HOME is the per-submission /box,
        # which is wiped between runs -- so without these every single C# submission would pay
        # for (and could fail on) that first-run setup. Set here rather than in the pipeline so
        # it applies to compile and execute alike.
        DOTNET_CLI_TELEMETRY_OPTOUT: 1
        DOTNET_SKIP_FIRST_TIME_EXPERIENCE: 1
        DOTNET_NOLOGO: 1
        DOTNET_CLI_HOME: /box
    bound-directories:
        - dst: "/tmp"
          mode: "tmp"
max-output-length: 4096
max-carboncopy-length: 1048576
cleanup-submission: false
...
