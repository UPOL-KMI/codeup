# Copy this file to .env and fill in real secrets before deploying.
#   cp .env.example .env

# ============ Public address ============
# For local testing, add "127.0.0.1  recodex.local" to your /etc/hosts and leave
# PROTOCOL=http. For production, point real DNS at this server and switch to
# PROTOCOL=https / MONITOR_PROTOCOL=wss / NOTIFIER_PORT=443 (and uncomment the TLS
# block in services/proxy/nginx.conf.template once you have a certificate).
APP_DOMAIN=recodex.local

# Where the core and the workers talk to each other *inside* the compose network. The public
# address above is what people's browsers use and what ends up in links; this one is what a worker
# uses to fetch a submission and upload its results, and it has to resolve in a container. Leave it
# alone unless you rename the `proxy` service: with APP_DOMAIN=localhost the public address cannot
# work here at all, because `localhost` in a container is that container.
API_INTERNAL_ADDRESS=http://proxy/api
PROTOCOL=http
MONITOR_PROTOCOL=ws
NOTIFIER_PORT=80
HTTP_PORT=80
# HTTPS_PORT=443

# ============ Database ============
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=recodex
MYSQL_USER=recodex
MYSQL_PASSWORD=changeme-db-password

# ============ Core API secrets ============
# Must be a random string, at least 32 characters (used to sign JWT access tokens).
JWT_SECRET=changeme-please-generate-a-long-random-string-32chars-min
# Shared secret between core-api and broker (must match on both sides - the
# compose file wires the same values into both automatically, just change here).
BROKER_AUTH_USER=broker
BROKER_AUTH_PASSWORD=changeme-broker-password
# Shared secret between core-api and every worker (HTTP basic auth for file transfer).
WORKER_FILES_AUTH_USER=worker
WORKER_FILES_AUTH_PASSWORD=changeme-workerfiles-password
TOKEN_COOKIE_PREFIX=recodex
LOCAL_REGISTRATION_ENABLED=false

# ============ Mail (used for password resets, notifications, etc.) ============
SMTP_HOST=smtp.example.com
SMTP_CLIENT_HOST=recodex.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=tls
MAIL_FROM=ReCodEx <noreply@recodex.local>
ADMIN_EMAIL=Administrator <admin@recodex.local>

# Seed the DB with an initial admin account + default runtimes/pipelines on first
# boot (admin@admin.com / admin -- CHANGE THE PASSWORD IMMEDIATELY AFTER FIRST LOGIN).
# Only happens once (guarded by a marker file in the api_storage volume).
RECODEX_SEED_DB=true

# The name this deployment gives itself -- the instance every account belongs to, shown on the
# landing page and in the sidebar. Applied **once, on the first boot that seeds the database**:
# upstream's own fixture calls it "Frankenstein University, Atlantida", which is fine for ReCodEx's
# test data and wrong for anybody running it. Renaming an instance later is a job for the admin
# screens, not for this file -- changing it here does nothing to a database that already exists.
RECODEX_INSTANCE_NAME=Univerzita Palackého v Olomouci
RECODEX_INSTANCE_DESCRIPTION=

# ============ web-app ============
WEB_APP_PORT=8080
# Shown in the legacy app's header, and -- since it reaches core-api's `emails.siteName`
# -- in every email subject and body this deployment sends.
RECODEX_TITLE=UPolníček

# ============ web-next (new Next.js frontend, dev/parity work in progress) ============
WEB_NEXT_PORT=3001

# ============ worker ============
WORKER_ID=1
WORKER_HWGROUP=01-default

# ============ logging ============
LOG_LEVEL=info
